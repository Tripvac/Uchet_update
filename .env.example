# Секреты только через окружение. В файлах репозитория — лишь пустые
# плейсхолдеры. Реальные значения на проде живут в Environment Variables Render.
TELEGRAM_BOT_TOKEN=
REQUIRED_SUBSCRIPTIONS=@uchetq,@uchetp

# Чат для технических уведомлений админу (BUG-2/NOTIFY-1). Необязательно.
ADMIN_CHAT_ID=5389921214

# Уровень логирования: DEBUG/INFO/WARNING/ERROR. По умолчанию INFO.
LOG_LEVEL=INFO

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=

CRM_WEBHOOK_URL=https://webhook.site/твой-уникальный-адрес

DEFAULT_LOCALE=ru
LOCALES_DIR=locales
SCREENS_PATH=map/screens.json
